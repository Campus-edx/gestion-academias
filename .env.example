# Plantilla del archivo .env (configuración privada de cada ordenador). Se copia como .env y no se sube a GitHub.
APP_NAME="ERP Formación"
# Entorno de desarrollo y errores con detalle.
APP_ENV=local
# Clave de cifrado: la rellena php artisan key:generate.
APP_KEY=
APP_DEBUG=true
# Dirección donde se abre la aplicación.
APP_URL=http://127.0.0.1:8001

# Idioma.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Registro de errores en storage/logs/laravel.log.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de datos: MySQL de XAMPP.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_formacion_beta
# Usuario root sin contraseña (lo normal en XAMPP).
DB_USERNAME=root
DB_PASSWORD=

# Sesiones guardadas en archivos, 120 minutos.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Otros servicios en modo simple: archivos y sin colas.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Los correos no se envían: se escriben en el log.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@erp-formacion.local"
MAIL_FROM_NAME="${APP_NAME}"
